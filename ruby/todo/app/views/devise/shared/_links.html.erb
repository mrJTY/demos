<div class="space-y-3">
  <%- if controller_name != 'sessions' %>
    <div>
      <%= link_to "Already have an account? Sign in", new_session_path(resource_name),
          class: "text-blue-600 hover:text-blue-800 text-sm font-medium transition duration-200" %>
    </div>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <div>
      <%= link_to "Don't have an account? Sign up", new_registration_path(resource_name),
          class: "text-blue-600 hover:text-blue-800 text-sm font-medium transition duration-200" %>
    </div>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <div>
      <%= link_to "Forgot your password?", new_password_path(resource_name),
          class: "text-gray-600 hover:text-gray-800 text-sm transition duration-200" %>
    </div>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <div>
      <%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name),
          class: "text-gray-600 hover:text-gray-800 text-sm transition duration-200" %>
    </div>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <div>
      <%= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name),
          class: "text-gray-600 hover:text-gray-800 text-sm transition duration-200" %>
    </div>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <div>
        <%= button_to "Sign in with #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider),
            data: { turbo: false },
            class: "w-full text-center py-2 px-4 border border-gray-300 rounded-md shadow-sm bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-200" %>
      </div>
    <% end %>
  <% end %>
</div>
