<div class="max-w-4xl mx-auto text-center">
  <!-- Hero Section -->
  <div class="mb-16">
    <h1 class="text-5xl font-bold text-gray-900 mb-6">
      Welcome to <span class="text-blue-600">Todo</span>
    </h1>
    <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
      The simplest and most effective way to organize your tasks, boost productivity, and achieve your goals.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <% if user_signed_in? %>
        <%= link_to "Go to My Todos", todos_path,
            class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition duration-200 shadow-lg hover:shadow-xl" %>
      <% else %>
        <%= link_to "Get Started", new_user_registration_path,
            class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition duration-200 shadow-lg hover:shadow-xl" %>
        <%= link_to "Sign In", new_user_session_path,
            class: "bg-white hover:bg-gray-50 text-blue-600 font-semibold py-3 px-8 rounded-lg border-2 border-blue-600 transition duration-200" %>
      <% end %>
    </div>
  </div>

  <!-- Features Section -->
  <div class="grid md:grid-cols-3 gap-8 mb-16">
    <div class="bg-white p-6 rounded-lg shadow-md">
      <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Simple Task Management</h3>
      <p class="text-gray-600">Create, organize, and track your todos with an intuitive interface.</p>
    </div>

    <div class="bg-white p-6 rounded-lg shadow-md">
      <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Smart Organization</h3>
      <p class="text-gray-600">Categorize tasks, set priorities, and never miss a deadline again.</p>
    </div>

    <div class="bg-white p-6 rounded-lg shadow-md">
      <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Boost Productivity</h3>
      <p class="text-gray-600">Stay focused and accomplish more with our streamlined workflow.</p>
    </div>
  </div>

  <!-- Stats Section -->
  <div class="bg-white rounded-lg shadow-md p-8 mb-16">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Why Choose Todo?</h2>
    <div class="grid md:grid-cols-4 gap-6">
      <div class="text-center">
        <div class="text-3xl font-bold text-blue-600 mb-2">100%</div>
        <div class="text-gray-600">Free to Use</div>
      </div>
      <div class="text-center">
        <div class="text-3xl font-bold text-green-600 mb-2">24/7</div>
        <div class="text-gray-600">Always Available</div>
      </div>
      <div class="text-center">
        <div class="text-3xl font-bold text-purple-600 mb-2">Secure</div>
        <div class="text-gray-600">Your Data is Safe</div>
      </div>
      <div class="text-center">
        <div class="text-3xl font-bold text-orange-600 mb-2">Fast</div>
        <div class="text-gray-600">Lightning Quick</div>
      </div>
    </div>
  </div>

  <!-- Footer CTA -->
  <div class="text-center">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Ready to Get Organized?</h2>
    <p class="text-gray-600 mb-6">Join thousands of users who have transformed their productivity with Todo.</p>
    <% if user_signed_in? %>
      <%= link_to "Start Managing Tasks", todos_path,
          class: "inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition duration-200 shadow-lg hover:shadow-xl" %>
    <% else %>
      <%= link_to "Create Free Account", new_user_registration_path,
          class: "inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-8 rounded-lg transition duration-200 shadow-lg hover:shadow-xl" %>
    <% end %>
  </div>
</div>
