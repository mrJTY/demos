<div class="max-w-2xl mx-auto">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Create New Todo</h1>
    <div class="flex gap-4">
      <%= link_to "Back to Todos", todos_path, class: "text-blue-600 hover:text-blue-800" %>
      <%= link_to "Home", root_path, class: "text-blue-600 hover:text-blue-800" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6">
    <%= form_with(model: @todo, local: true, class: "space-y-6") do |f| %>
      <% if @todo.errors.any? %>
        <div class="rounded-md bg-red-50 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800">
                <%= pluralize(@todo.errors.count, "error") %> prohibited this todo from being saved:
              </h3>
              <div class="mt-2 text-sm text-red-700">
                <ul class="list-disc pl-5 space-y-1">
                  <% @todo.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div>
        <%= f.label :title, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :title,
            class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500",
            placeholder: "What needs to be done?" %>
      </div>

      <div>
        <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :description, rows: 4,
            class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500",
            placeholder: "Add any additional details..." %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :due_date, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.datetime_local_field :due_date,
              class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :priority, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.select :priority,
              options_for_select([
                ['Low (1)', 1],
                ['Medium (2)', 2],
                ['Normal (3)', 3],
                ['High (4)', 4],
                ['Urgent (5)', 5]
              ], @todo.priority || 3),
              {},
              class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
        </div>
      </div>

      <div class="flex justify-end space-x-3 pt-4">
        <%= link_to "Cancel", todos_path,
            class: "px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-200" %>
        <%= f.submit "Create Todo",
            class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-200" %>
      </div>
    <% end %>
  </div>
</div>
