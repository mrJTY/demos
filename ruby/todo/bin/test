#!/usr/bin/env bash

# Test runner script for Todo Rails application
# Usage: ./bin/test [options] [test_paths...]

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default values
FORMAT="progress"
COVERAGE=false
PARALLEL=false
VERBOSE=false
HELP=false

# Function to print colored output
print_color() {
    local color=$1
    local message=$2
    echo -e "${color}${message}${NC}"
}

# Function to show help
show_help() {
    cat << EOF
Test Runner for Todo Rails Application

Usage: ./bin/test [options] [test_paths...]

Options:
    -h, --help              Show this help message
    -f, --format FORMAT     Output format (progress, documentation, json, html)
    -c, --coverage          Run with coverage (requires simplecov gem)
    -p, --parallel          Run tests in parallel (requires parallel_rspec gem)
    -v, --verbose           Verbose output
    -a, --all               Run all tests (default)
    -m, --models            Run only model tests
    -r, --requests          Run only request tests
    -s, --system            Run only system tests
    -u, --unit              Run unit tests (models + helpers)
    --fail-fast             Stop on first failure
    --seed SEED             Run with specific seed for reproducible failures

Examples:
    ./bin/test                           # Run all tests
    ./bin/test -f documentation         # Run all tests with detailed output
    ./bin/test -m                       # Run only model tests
    ./bin/test -r spec/requests/        # Run specific directory
    ./bin/test spec/models/todo_spec.rb # Run specific file
    ./bin/test -e "User Registration"   # Run tests matching pattern
    ./bin/test --fail-fast              # Stop on first failure

Environment Variables:
    RAILS_ENV=test                      # Set Rails environment (default: test)
    COVERAGE=true                       # Enable coverage (same as -c flag)

EOF
}

# Function to check if a gem is available
gem_available() {
    local gem_name=$1
    bundle list | grep -q "$gem_name"
}

# Function to run tests
run_tests() {
    local args=("$@")
    local cmd="bundle exec rspec"

    # Add format if specified
    if [[ -n "$FORMAT" ]]; then
        cmd="$cmd --format $FORMAT"
    fi

    # Add coverage if enabled
    if [[ "$COVERAGE" == true ]]; then
        if gem_available "simplecov"; then
            export COVERAGE=true
            print_color $BLUE "Running tests with coverage..."
        else
            print_color $YELLOW "Warning: simplecov gem not found. Coverage disabled."
            COVERAGE=false
        fi
    fi

    # Add parallel if enabled
    if [[ "$PARALLEL" == true ]]; then
        if gem_available "parallel_rspec"; then
            cmd="bundle exec parallel_rspec"
            print_color $BLUE "Running tests in parallel..."
        else
            print_color $YELLOW "Warning: parallel_rspec gem not found. Running sequentially."
            PARALLEL=false
        fi
    fi

    # Add fail-fast if specified
    if [[ "$FAIL_FAST" == true ]]; then
        cmd="$cmd --fail-fast"
    fi

    # Add seed if specified
    if [[ -n "$SEED" ]]; then
        cmd="$cmd --seed $SEED"
    fi

    # Add test paths or default to all
    if [[ ${#args[@]} -eq 0 ]]; then
        cmd="$cmd spec/"
    else
        cmd="$cmd ${args[*]}"
    fi

    print_color $BLUE "Running: $cmd"
    echo

    # Execute the command
    if eval "$cmd"; then
        print_color $GREEN "✅ All tests passed!"
        exit 0
    else
        print_color $RED "❌ Some tests failed!"
        exit 1
    fi
}

# Function to run specific test types
run_test_type() {
    local test_type=$1
    case $test_type in
        "models"|"m")
            print_color $BLUE "Running model tests..."
            run_tests spec/models/
            ;;
        "requests"|"r")
            print_color $BLUE "Running request tests..."
            run_tests spec/requests/
            ;;
        "system"|"s")
            print_color $BLUE "Running system tests..."
            run_tests spec/system/
            ;;
        "unit"|"u")
            print_color $BLUE "Running unit tests..."
            run_tests spec/models/ spec/helpers/
            ;;
        "all"|"a")
            print_color $BLUE "Running all tests..."
            run_tests
            ;;
        *)
            print_color $RED "Unknown test type: $test_type"
            show_help
            exit 1
            ;;
    esac
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            HELP=true
            shift
            ;;
        -f|--format)
            FORMAT="$2"
            shift 2
            ;;
        -c|--coverage)
            COVERAGE=true
            shift
            ;;
        -p|--parallel)
            PARALLEL=true
            shift
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -a|--all)
            run_test_type "all"
            exit 0
            ;;
        -m|--models)
            run_test_type "models"
            exit 0
            ;;
        -r|--requests)
            run_test_type "requests"
            exit 0
            ;;
        -s|--system)
            run_test_type "system"
            exit 0
            ;;
        -u|--unit)
            run_test_type "unit"
            exit 0
            ;;
        --fail-fast)
            FAIL_FAST=true
            shift
            ;;
        --seed)
            SEED="$2"
            shift 2
            ;;
        -*)
            print_color $RED "Unknown option: $1"
            show_help
            exit 1
            ;;
        *)
            # This is a test path or pattern
            break
            ;;
    esac
done

# Show help if requested
if [[ "$HELP" == true ]]; then
    show_help
    exit 0
fi

# Check if we're in a Rails application
if [[ ! -f "Gemfile" ]] || [[ ! -d "spec" ]]; then
    print_color $RED "Error: This doesn't appear to be a Rails application with RSpec."
    print_color $RED "Please run this script from the root of your Rails application."
    exit 1
fi

# Check if RSpec is available
if ! gem_available "rspec-rails"; then
    print_color $RED "Error: rspec-rails gem not found."
    print_color $RED "Please add rspec-rails to your Gemfile and run 'bundle install'."
    exit 1
fi

# Set default Rails environment if not set
export RAILS_ENV=${RAILS_ENV:-test}

print_color $GREEN "🚀 Todo Test Runner"
print_color $BLUE "Rails Environment: $RAILS_ENV"
echo

# Run the tests
run_tests "$@"
