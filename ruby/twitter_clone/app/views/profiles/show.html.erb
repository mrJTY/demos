<div class="min-h-screen bg-gray-50">
  <!-- Header -->
  <header class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <div class="flex items-center">
          <svg class="h-8 w-8 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
          </svg>
          <h1 class="ml-3 text-xl font-bold text-gray-900">TwitterClone</h1>
        </div>

        <div class="flex items-center space-x-4">
          <%= link_to "Home", tweets_path, class: "text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium" %>
          <div class="flex items-center space-x-3">
            <div class="flex-shrink-0">
              <div class="h-8 w-8 rounded-full bg-blue-600 flex items-center justify-center">
                <span class="text-sm font-medium text-white"><%= @user.username.first.upcase %></span>
              </div>
            </div>
            <div class="hidden md:block">
              <p class="text-sm font-medium text-gray-900"><%= @user.username %></p>
              <p class="text-xs text-gray-500"><%= @user.email %></p>
            </div>
          </div>
          <%= button_to "Sign Out", destroy_user_session_path, method: :delete,
              class: "bg-red-600 hover:bg-red-700 text-white px-3 py-2 rounded-md text-sm font-medium transition-colors" %>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Profile Header -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 mb-8">
      <div class="flex items-start justify-between">
        <div class="flex items-center space-x-6">
          <div class="flex-shrink-0">
            <div class="h-24 w-24 rounded-full bg-blue-600 flex items-center justify-center">
              <span class="text-3xl font-bold text-white"><%= @user.username.first.upcase %></span>
            </div>
          </div>

          <div>
            <h1 class="text-2xl font-bold text-gray-900"><%= @user.username %></h1>
            <p class="text-gray-600 mt-1"><%= @user.email %></p>
            <% if @user.bio.present? %>
              <p class="text-gray-700 mt-3 max-w-md"><%= @user.bio %></p>
            <% else %>
              <p class="text-gray-500 mt-3 italic">No bio yet</p>
            <% end %>
            <div class="flex items-center space-x-6 mt-4 text-sm text-gray-500">
              <span><%= @tweets.count %> tweets</span>
              <span><%= @user.likes.count %> likes</span>
              <span>Joined <%= @user.created_at.strftime("%B %Y") %></span>
            </div>
          </div>
        </div>

        <div class="flex space-x-3">
          <%= link_to edit_profile_path,
              class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors" do %>
            Edit Profile
          <% end %>
          <%= link_to edit_user_registration_path,
              class: "bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-medium transition-colors" do %>
            Account Settings
          <% end %>
        </div>
      </div>
    </div>

    <!-- User's Tweets -->
    <div class="space-y-4">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-900">Your Tweets</h2>
        <%= link_to "New Tweet", tweets_path,
            class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors" %>
      </div>

      <% if @tweets.any? %>
        <% @tweets.each do |tweet| %>
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
            <div class="flex space-x-4">
              <div class="flex-shrink-0">
                <div class="h-12 w-12 rounded-full bg-blue-600 flex items-center justify-center">
                  <span class="text-lg font-medium text-white"><%= tweet.user.username.first.upcase %></span>
                </div>
              </div>

              <div class="flex-1 min-w-0">
                <div class="flex items-center space-x-2 mb-2">
                  <p class="text-sm font-semibold text-gray-900"><%= tweet.user.username %></p>
                  <span class="text-gray-400">·</span>
                  <p class="text-sm text-gray-500"><%= tweet.time_ago %> ago</p>
                  <% if tweet.likes.any? %>
                    <span class="text-gray-400">·</span>
                    <div class="flex items-center space-x-1 text-sm text-gray-500">
                      <svg class="h-4 w-4 text-red-500" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                      </svg>
                      <span><%= tweet.likes.count %></span>
                    </div>
                  <% end %>
                </div>

                <p class="text-gray-900 text-lg leading-relaxed mb-4"><%= tweet.content %></p>

                <div class="flex items-center justify-between">
                  <div class="flex items-center space-x-8">
                    <!-- Like Button -->
                    <%= render 'tweets/like_button', tweet: tweet, current_user: current_user %>

                    <!-- Delete Button -->
                    <%= button_to tweet_path(tweet), method: :delete,
                        class: "text-red-500 hover:text-red-700 transition-colors",
                        data: { confirm: "Are you sure you want to delete this tweet?" } do %>
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <!-- Empty State -->
        <div class="text-center py-12 bg-white rounded-xl shadow-sm border border-gray-200">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No tweets yet</h3>
          <p class="mt-1 text-sm text-gray-500">Start sharing what's happening!</p>
          <div class="mt-6">
            <%= link_to "Write your first tweet", tweets_path,
                class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors" %>
          </div>
        </div>
      <% end %>
    </div>
  </main>
</div>
