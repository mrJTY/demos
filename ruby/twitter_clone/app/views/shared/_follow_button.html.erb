<%# Renders a follow/unfollow button for a given user %>
<% if local_assigns[:user].present? && user != current_user %>
  <% if current_user.following?(user) %>
    <%= button_to follow_path(user), method: :delete,
        class: "text-gray-500 hover:text-red-600 transition-colors text-sm" do %>
      Unfollow
    <% end %>
  <% else %>
    <%= button_to follows_path(followed_id: user.id), method: :post,
        class: "text-blue-600 hover:text-blue-700 transition-colors text-sm" do %>
      Follow
    <% end %>
  <% end %>
<% end %>
